{
  "name": "cadence-piano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "tsx scripts/fixtures.ts",
    "plan:pathetique": "tsx scripts/pathetique-plan.ts",
    "prepare:debussy-la-fille": "tsx scripts/debussy-la-fille-prepare.ts",
    "plan:debussy-la-fille": "tsx scripts/debussy-la-fille-plan.ts",
    "score:debussy-la-fille": "python3 scripts/prepare-score.py render public/pieces/debussy-la-fille-aux-cheveux-de-lin.pdf scripts/scores/debussy-la-fille-aux-cheveux-de-lin.cuts.json --output public/scores/debussy-la-fille-aux-cheveux-de-lin --scale 3",
    "align:debussy-la-fille": "tsx scripts/align-score.ts src/core/debussy-la-fille-aux-cheveux-de-lin.json public/scores/debussy-la-fille-aux-cheveux-de-lin/geometry.json /pieces/debussy-la-fille-aux-cheveux-de-lin.pdf",
    "benchmark": "tsx scripts/benchmark.ts",
    "score:pathetique": "tsx scripts/align-score.ts src/core/pathetique.json public/scores/pathetique-ii/geometry.json /pieces/pathetique-2.pdf",
    "report:ballade-barton": "tsx scripts/ballade-barton-report.ts"
  },
  "dependencies": {
    "@tonejs/midi": "2.0.28",
    "dexie": "4.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vexflow": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
